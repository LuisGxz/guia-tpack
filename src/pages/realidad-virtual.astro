---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ToolCard from '../components/ToolCard.astro';
import GuideProgress from '../components/GuideProgress.astro';
import OtherTechnologies from '../components/OtherTechnologies.astro';
import SectionNav from '../components/SectionNav.astro';
import tools from '../data/tools-vr.json';
---

<MainLayout title="Realidad Virtual — Guía Interactiva">
  <main class="flex-1">
    <GuideProgress currentSlug="realidad-virtual" />
    <!-- Hero -->
    <section class="bg-primary text-white py-16 md:py-20 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-6">
          <span class="text-3xl" aria-hidden="true">🥽</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
          Realidad Virtual en la Educación
        </h1>
        <p class="text-base md:text-lg text-white/80 max-w-2xl mx-auto">
          Experiencias inmersivas que transforman la manera en que los estudiantes exploran conceptos, lugares y fenómenos.
        </p>
      </div>
    </section>

    <!-- Tab Navigation -->
    <div class="sticky top-16 z-30 bg-background border-b border-border">
      <div class="max-w-4xl mx-auto px-4">
        <nav class="flex gap-1 -mb-px" role="tablist" aria-label="Secciones de Realidad Virtual">
          <button role="tab" aria-selected="true" aria-controls="panel-que-es" id="tab-que-es"
            class="tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-accent text-accent transition-colors">
            Qué es
          </button>
          <button role="tab" aria-selected="false" aria-controls="panel-herramientas" id="tab-herramientas"
            class="tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-text-light hover:text-text transition-colors">
            Herramientas
          </button>
          <button role="tab" aria-selected="false" aria-controls="panel-estrategia" id="tab-estrategia"
            class="tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-text-light hover:text-text transition-colors">
            Estrategia
          </button>
        </nav>
      </div>
    </div>

    <!-- Panel: Qué es -->
    <div role="tabpanel" id="panel-que-es" aria-labelledby="tab-que-es" class="tab-panel">
      <section class="max-w-4xl mx-auto px-4 py-16">
        <SectionHeader
          title="¿Qué es la Realidad Virtual?"
          subtitle="Tecnología inmersiva que transporta al usuario a entornos digitales tridimensionales."
        />
        <div class="space-y-4 text-text-light mt-8">
          <p>
            La <strong class="text-text">Realidad Virtual (RV)</strong> es una tecnología que crea entornos
            digitales tridimensionales en los que el usuario puede sumergirse e interactuar. A diferencia de
            una pantalla tradicional, la RV genera una sensación de <strong class="text-text">presencia</strong>:
            el estudiante siente que está «dentro» del contenido.
          </p>
          <p>
            En educación, la RV no requiere necesariamente visores costosos. Muchas experiencias son accesibles
            desde navegadores web o dispositivos móviles con Google Cardboard, un visor económico de cartón.
          </p>

          <h3 class="text-lg font-bold text-primary pt-4">¿Por qué importa para la educación?</h3>
          <ul class="space-y-2 list-none pl-0">
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 shrink-0">→</span>
              <span><strong class="text-text">Aprendizaje experiencial:</strong> Los estudiantes viven los conceptos en lugar de solo leerlos. Recorren el sistema solar, caminan por Roma antigua o exploran una célula.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 shrink-0">→</span>
              <span><strong class="text-text">Motivación:</strong> Las experiencias inmersivas generan mayor engagement y retención del conocimiento.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 shrink-0">→</span>
              <span><strong class="text-text">Acceso a lo inaccesible:</strong> Permite visitar lugares, épocas o escalas que serían imposibles en el mundo real.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 shrink-0">→</span>
              <span><strong class="text-text">Seguridad:</strong> Simulaciones de laboratorio o situaciones peligrosas sin riesgo real.</span>
            </li>
          </ul>

          <h3 class="text-lg font-bold text-primary pt-4">El rol del directivo</h3>
          <p>
            La adopción de RV requiere una planificación cuidadosa por parte del equipo directivo:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
            <div class="p-4 rounded-lg border border-border bg-white">
              <h4 class="font-bold text-sm mb-1">Evaluar la infraestructura</h4>
              <p class="text-sm">Verificar conectividad a internet, disponibilidad de dispositivos y espacios físicos adecuados para experiencias inmersivas.</p>
            </div>
            <div class="p-4 rounded-lg border border-border bg-white">
              <h4 class="font-bold text-sm mb-1">Priorizar materias de alto impacto</h4>
              <p class="text-sm">Identificar qué asignaturas se benefician más de la inmersión: ciencias naturales, historia, geografía, arte.</p>
            </div>
            <div class="p-4 rounded-lg border border-border bg-white">
              <h4 class="font-bold text-sm mb-1">Comenzar con lo accesible</h4>
              <p class="text-sm">Iniciar con herramientas basadas en navegador (Google Arts & Culture, Mozilla Hubs) antes de invertir en hardware.</p>
            </div>
            <div class="p-4 rounded-lg border border-border bg-white">
              <h4 class="font-bold text-sm mb-1">Gestionar el tiempo de uso</h4>
              <p class="text-sm">Establecer protocolos de uso responsable: duración de sesiones, descansos, y consideraciones de bienestar digital.</p>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Panel: Herramientas -->
    <div role="tabpanel" id="panel-herramientas" aria-labelledby="tab-herramientas" class="tab-panel hidden">
      <section class="max-w-6xl mx-auto px-4 py-16">
        <SectionHeader
          title="Herramientas de RV para educación"
          subtitle="Plataformas accesibles para incorporar experiencias de realidad virtual en tu institución educativa. Haz clic en cada herramienta para ver el detalle completo."
        />
        <!-- Filter Pills -->
        <div class="flex gap-2 mt-6 mb-8" role="radiogroup" aria-label="Filtrar herramientas">
          <button class="filter-btn active px-4 py-2 rounded-full text-sm font-semibold border-2 border-accent bg-accent text-white transition-colors" data-filter="all">
            Todas
          </button>
          <button class="filter-btn px-4 py-2 rounded-full text-sm font-semibold border-2 border-border text-text-light hover:border-violet-400 hover:text-violet-700 transition-colors" data-filter="open-source">
            Código Abierto
          </button>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 tool-grid">
          {tools.map((tool) => (
            <ToolCard {...tool} />
          ))}
        </div>
      </section>
    </div>

    <!-- Panel: Estrategia -->
    <div role="tabpanel" id="panel-estrategia" aria-labelledby="tab-estrategia" class="tab-panel hidden">
      <section class="max-w-5xl mx-auto px-4 py-16">
        <SectionHeader
          title="Estrategia de integración de RV"
          subtitle="Hoja de ruta práctica para que directivos y docentes lideren la adopción de realidad virtual en su institución."
        />

        <!-- Roadmap -->
        <div class="mt-10">
          <h3 class="text-lg font-bold text-primary mb-6">Hoja de ruta por fases</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="relative p-5 rounded-xl border-2 border-accent/30 bg-accent/5">
              <div class="w-10 h-10 rounded-full bg-accent text-white font-bold flex items-center justify-center text-lg mb-3">1</div>
              <h4 class="font-bold text-sm text-primary mb-2">Auditar infraestructura</h4>
              <p class="text-xs text-text-light mb-3">Evaluar conectividad, dispositivos disponibles, ancho de banda y espacios físicos para experiencias inmersivas.</p>
              <div class="text-xs font-semibold text-accent">Sesiones 1-3 (Semana 1)</div>
              <ul class="mt-2 space-y-1 text-xs text-text-light">
                <li class="flex items-start gap-1"><span class="text-accent shrink-0">✓</span> Test de velocidad de internet en aulas</li>
                <li class="flex items-start gap-1"><span class="text-accent shrink-0">✓</span> Inventario de computadoras y tablets</li>
                <li class="flex items-start gap-1"><span class="text-accent shrink-0">✓</span> Identificar espacios seguros para uso de VR</li>
              </ul>
            </div>
            <div class="relative p-5 rounded-xl border-2 border-primary/20 bg-primary/5">
              <div class="w-10 h-10 rounded-full bg-primary text-white font-bold flex items-center justify-center text-lg mb-3">2</div>
              <h4 class="font-bold text-sm text-primary mb-2">Seleccionar y planificar</h4>
              <p class="text-xs text-text-light mb-3">Elegir herramientas que funcionen con la infraestructura existente. Priorizar las que no requieren hardware especializado.</p>
              <div class="text-xs font-semibold text-primary">Sesiones 4-6 (Semana 2)</div>
              <ul class="mt-2 space-y-1 text-xs text-text-light">
                <li class="flex items-start gap-1"><span class="text-primary shrink-0">✓</span> Seleccionar 2 herramientas basadas en navegador</li>
                <li class="flex items-start gap-1"><span class="text-primary shrink-0">✓</span> Identificar materias de alto impacto</li>
                <li class="flex items-start gap-1"><span class="text-primary shrink-0">✓</span> Opcional: adquirir visores Google Cardboard ($3-5 c/u)</li>
              </ul>
            </div>
            <div class="relative p-5 rounded-xl border-2 border-green-500/20 bg-green-50">
              <div class="w-10 h-10 rounded-full bg-green-500 text-white font-bold flex items-center justify-center text-lg mb-3">3</div>
              <h4 class="font-bold text-sm text-primary mb-2">Piloto inmersivo</h4>
              <p class="text-xs text-text-light mb-3">Ejecutar experiencias de RV en 2-3 materias con docentes seleccionados. Documentar reacciones y resultados.</p>
              <div class="text-xs font-semibold text-green-600">Sesiones 7-9 (Semana 3)</div>
              <ul class="mt-2 space-y-1 text-xs text-text-light">
                <li class="flex items-start gap-1"><span class="text-green-500 shrink-0">✓</span> 1 experiencia VR por semana en cada materia piloto</li>
                <li class="flex items-start gap-1"><span class="text-green-500 shrink-0">✓</span> Protocolo de uso (duración, descansos)</li>
                <li class="flex items-start gap-1"><span class="text-green-500 shrink-0">✓</span> Registro fotográfico y testimonios</li>
              </ul>
            </div>
            <div class="relative p-5 rounded-xl border-2 border-violet-500/20 bg-violet-50">
              <div class="w-10 h-10 rounded-full bg-violet-500 text-white font-bold flex items-center justify-center text-lg mb-3">4</div>
              <h4 class="font-bold text-sm text-primary mb-2">Evaluar y expandir</h4>
              <p class="text-xs text-text-light mb-3">Medir el impacto en engagement y aprendizaje. Decidir si se invierte en hardware adicional o se mantienen herramientas web.</p>
              <div class="text-xs font-semibold text-violet-600">Sesiones 10-12 (Semana 4)</div>
              <ul class="mt-2 space-y-1 text-xs text-text-light">
                <li class="flex items-start gap-1"><span class="text-violet-500 shrink-0">✓</span> Encuesta de impacto a docentes y estudiantes</li>
                <li class="flex items-start gap-1"><span class="text-violet-500 shrink-0">✓</span> Análisis costo-beneficio de hardware VR</li>
                <li class="flex items-start gap-1"><span class="text-violet-500 shrink-0">✓</span> Plan de expansión para el siguiente año</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Decision Matrix -->
        <div class="mt-12">
          <h3 class="text-lg font-bold text-primary mb-2">Matriz de decisión: ¿Qué herramienta usar?</h3>
          <p class="text-sm text-text-light mb-4">Selecciona la herramienta según el área curricular y el nivel de infraestructura disponible.</p>
          <div class="overflow-x-auto rounded-xl border border-border">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-primary text-white">
                  <th class="p-3 text-left font-semibold text-xs uppercase tracking-wide">Materia</th>
                  <th class="p-3 text-left font-semibold text-xs uppercase tracking-wide">Solo navegador</th>
                  <th class="p-3 text-left font-semibold text-xs uppercase tracking-wide">Con Google Cardboard</th>
                  <th class="p-3 text-left font-semibold text-xs uppercase tracking-wide">Con PC potente</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr class="bg-white">
                  <td class="p-3 font-semibold text-primary">Estudios Sociales</td>
                  <td class="p-3 text-text-light">Google Arts & Culture, Google Earth</td>
                  <td class="p-3 text-text-light">Tour Creator</td>
                  <td class="p-3 text-text-light">OpenSpace, Mozilla Hubs</td>
                </tr>
                <tr class="bg-stone-50">
                  <td class="p-3 font-semibold text-primary">Ciencias Naturales</td>
                  <td class="p-3 text-text-light">Sketchfab, Google Earth</td>
                  <td class="p-3 text-text-light">Tour Creator</td>
                  <td class="p-3 text-text-light">OpenSpace, CoSpaces Edu</td>
                </tr>
                <tr class="bg-white">
                  <td class="p-3 font-semibold text-primary">Ed. Artística</td>
                  <td class="p-3 text-text-light">Google Arts & Culture</td>
                  <td class="p-3 text-text-light">ThingLink 360°</td>
                  <td class="p-3 text-text-light">Mozilla Hubs, CoSpaces Edu</td>
                </tr>
                <tr class="bg-stone-50">
                  <td class="p-3 font-semibold text-primary">Informática</td>
                  <td class="p-3 text-text-light">A-Frame (HTML)</td>
                  <td class="p-3 text-text-light">A-Frame + Cardboard</td>
                  <td class="p-3 text-text-light">Godot Engine, Mozilla Hubs</td>
                </tr>
                <tr class="bg-white">
                  <td class="p-3 font-semibold text-primary">Matemáticas</td>
                  <td class="p-3 text-text-light">Sketchfab (geometría 3D)</td>
                  <td class="p-3 text-text-light">CoSpaces Edu</td>
                  <td class="p-3 text-text-light">Godot Engine</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-xs text-text-light mt-2 italic">La mayoría de herramientas funcionan con solo un navegador web. Los visores Google Cardboard ($3-5) mejoran la inmersión sin gran inversión.</p>
        </div>

        <!-- KPIs -->
        <div class="mt-12">
          <h3 class="text-lg font-bold text-primary mb-4">Indicadores de éxito</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="p-4 rounded-xl bg-accent/5 border border-accent/20 text-center">
              <div class="text-2xl font-bold text-accent mb-1">4+</div>
              <p class="text-xs text-text-light">Experiencias de RV integradas en el currículo por semestre</p>
            </div>
            <div class="p-4 rounded-xl bg-green-50 border border-green-200 text-center">
              <div class="text-2xl font-bold text-green-600 mb-1">60%</div>
              <p class="text-xs text-text-light">Docentes de áreas prioritarias usando al menos una herramienta VR</p>
            </div>
            <div class="p-4 rounded-xl bg-violet-50 border border-violet-200 text-center">
              <div class="text-2xl font-bold text-violet-600 mb-1">+25%</div>
              <p class="text-xs text-text-light">Incremento en engagement estudiantil en clases con RV (observación)</p>
            </div>
            <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-center">
              <div class="text-2xl font-bold text-amber-600 mb-1">$0</div>
              <p class="text-xs text-text-light">Inversión inicial requerida si se usan herramientas basadas en navegador</p>
            </div>
          </div>
        </div>

        <!-- Hypothetical Scenario -->
        <div class="mt-12">
          <h3 class="text-lg font-bold text-primary mb-4">Escenario hipotético de implementación</h3>
          <div class="p-6 rounded-xl bg-white border border-border shadow-sm">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center shrink-0">
                <span class="text-xl" aria-hidden="true">💡</span>
              </div>
              <div>
                <h4 class="font-bold text-base text-primary mb-1">Colegio urbano con bajo interés estudiantil en Estudios Sociales y presupuesto limitado</h4>
                <p class="text-sm text-text-light mb-3">
                  Consideremos una unidad educativa urbana donde las clases de Estudios Sociales e Historia presentan bajo interés estudiantil.
                  La institución cuenta con WiFi estable y un laboratorio de informática con computadoras actualizadas, pero no tiene presupuesto para adquirir visores de realidad virtual.
                </p>
                <div class="space-y-2 text-sm">
                  <p><strong class="text-text">Paso 1 — Auditoría:</strong> El rector podría verificar la infraestructura disponible: conectividad, navegadores actualizados y cantidad de equipos por estudiante.</p>
                  <p><strong class="text-text">Paso 2 — Selección:</strong> Herramientas como <span class="font-semibold text-accent">Google Arts & Culture</span> (recorridos por museos) y <span class="font-semibold text-accent">Google Earth</span> (expediciones geográficas) son gratuitas y basadas en navegador, lo que elimina la necesidad de visores.</p>
                  <p><strong class="text-text">Paso 3 — Piloto:</strong> Los docentes de Estudios Sociales podrían incorporar recorridos virtuales semanales a lugares como museos internacionales, sitios arqueológicos o patrimonios naturales del Ecuador, vinculándolos con los contenidos del currículo.</p>
                  <p><strong class="text-text">Resultado esperado:</strong> La investigación indica que las experiencias inmersivas pueden aumentar la participación y el interés estudiantil en materias de ciencias sociales, al ofrecer un contexto visual y experiencial que complementa la instrucción tradicional.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TPACK Connection -->
        <div class="mt-12 p-6 rounded-xl bg-primary/5 border border-primary/10">
          <h3 class="font-bold text-base text-primary mb-3">Conexión con el marco TPACK</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="flex items-start gap-3">
              <span class="w-8 h-8 rounded-full bg-[#0ea5e9]/15 flex items-center justify-center text-sm font-bold text-[#0ea5e9] shrink-0">T</span>
              <div>
                <h4 class="font-semibold text-sm">Tecnológico</h4>
                <p class="text-xs text-text-light">El docente navega entornos virtuales con fluidez, crea recorridos personalizados y guía a los estudiantes en experiencias inmersivas.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-8 h-8 rounded-full bg-[#8b5cf6]/15 flex items-center justify-center text-sm font-bold text-[#8b5cf6] shrink-0">P</span>
              <div>
                <h4 class="font-semibold text-sm">Pedagógico</h4>
                <p class="text-xs text-text-light">La RV se integra como vehículo de aprendizaje experiencial: no es solo «ver», sino observar, analizar, comparar y producir conocimiento a partir de la experiencia.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-8 h-8 rounded-full bg-[#10b981]/15 flex items-center justify-center text-sm font-bold text-[#10b981] shrink-0">C</span>
              <div>
                <h4 class="font-semibold text-sm">Contenido</h4>
                <p class="text-xs text-text-light">Cada experiencia VR está vinculada a objetivos de aprendizaje del currículo: un recorrido por el Antiguo Egipto se conecta con la unidad de civilizaciones antiguas.</p>
              </div>
            </div>
          </div>
        </div>

      </section>
    </div>

    <OtherTechnologies currentSlug="realidad-virtual" />
    <SectionNav currentSlug="realidad-virtual" />
  </main>
</MainLayout>

<script>
  function initTabs() {
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');
    if (!tabs.length || !panels.length) return;
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('aria-controls');
        tabs.forEach((t) => {
          t.setAttribute('aria-selected', 'false');
          t.classList.remove('border-accent', 'text-accent');
          t.classList.add('border-transparent', 'text-text-light');
        });
        tab.setAttribute('aria-selected', 'true');
        tab.classList.add('border-accent', 'text-accent');
        tab.classList.remove('border-transparent', 'text-text-light');
        panels.forEach((p) => { p.classList.toggle('hidden', p.id !== targetId); });
      });
      tab.addEventListener('keydown', (e) => {
        const tabsArr = Array.from(tabs);
        const idx = tabsArr.indexOf(tab);
        let newIdx = idx;
        if ((e as KeyboardEvent).key === 'ArrowRight') newIdx = (idx + 1) % tabsArr.length;
        if ((e as KeyboardEvent).key === 'ArrowLeft') newIdx = (idx - 1 + tabsArr.length) % tabsArr.length;
        if (newIdx !== idx) { (tabsArr[newIdx] as HTMLElement).focus(); (tabsArr[newIdx] as HTMLElement).click(); }
      });
    });
  }
  function initFilter() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.tool-card');
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = (btn as HTMLElement).dataset.filter;
        filterBtns.forEach((b) => { b.classList.remove('active', 'bg-accent', 'text-white', 'border-accent'); b.classList.add('border-border', 'text-text-light'); });
        btn.classList.add('active', 'bg-accent', 'text-white', 'border-accent'); btn.classList.remove('border-border', 'text-text-light');
        cards.forEach((card) => {
          const isOS = (card as HTMLElement).dataset.openSource === 'true';
          (card as HTMLElement).style.display = (filter === 'all' || isOS) ? '' : 'none';
        });
      });
    });
  }
  initTabs(); initFilter();
  document.addEventListener('astro:after-swap', () => { initTabs(); initFilter(); });
</script>
