---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ToolCard from '../components/ToolCard.astro';
import GuideProgress from '../components/GuideProgress.astro';
import OtherTechnologies from '../components/OtherTechnologies.astro';
import SectionNav from '../components/SectionNav.astro';
import tools from '../data/tools-simulaciones.json';
---

<MainLayout title="Simulaciones Interactivas — Guía Interactiva">
  <main class="flex-1">
    <GuideProgress currentSlug="simulaciones" />
    <!-- Hero -->
    <section class="bg-primary text-white py-16 md:py-20 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-6">
          <span class="text-3xl" aria-hidden="true">🧪</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
          Simulaciones Interactivas en la Educación
        </h1>
        <p class="text-base md:text-lg text-white/80 max-w-2xl mx-auto">
          Laboratorios virtuales, simuladores de física y matemáticas dinámicas que permiten experimentar, explorar y aprender sin límites de materiales ni riesgo.
        </p>
      </div>
    </section>

    <!-- Tab Navigation -->
    <div class="sticky top-16 z-30 bg-background border-b border-border">
      <div class="max-w-4xl mx-auto px-4">
        <nav class="flex gap-1 -mb-px" role="tablist" aria-label="Secciones de Simulaciones Interactivas">
          <button role="tab" aria-selected="true" aria-controls="panel-que-es" id="tab-que-es"
            class="tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-accent text-accent transition-colors">
            Qué es
          </button>
          <button role="tab" aria-selected="false" aria-controls="panel-herramientas" id="tab-herramientas"
            class="tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-text-light hover:text-text transition-colors">
            Herramientas
          </button>
          <button role="tab" aria-selected="false" aria-controls="panel-estrategia" id="tab-estrategia"
            class="tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-text-light hover:text-text transition-colors">
            Estrategia
          </button>
        </nav>
      </div>
    </div>

    <!-- Panel: Qué es -->
    <div role="tabpanel" id="panel-que-es" aria-labelledby="tab-que-es" class="tab-panel">
      <section class="max-w-4xl mx-auto px-4 py-16">
        <SectionHeader
          title="¿Qué son las Simulaciones Interactivas?"
          subtitle="Entornos digitales que reproducen fenómenos reales para experimentar sin límites."
        />
        <div class="space-y-4 text-text-light mt-8">
          <p>
            Las <strong class="text-text">Simulaciones Interactivas</strong> son programas que reproducen
            fenómenos naturales, procesos matemáticos, circuitos eléctricos, reacciones químicas y otros
            sistemas del mundo real en un entorno digital controlado. El estudiante puede manipular variables,
            observar resultados en tiempo real y repetir experimentos sin costo de materiales ni riesgo.
          </p>
          <p>
            A diferencia de un video o una imagen estática, la simulación permite la
            <strong class="text-text">experimentación activa</strong>: el estudiante cambia un parámetro
            y ve inmediatamente cómo afecta al sistema. Esta interactividad desarrolla intuición científica
            y pensamiento crítico de una forma que el aprendizaje pasivo no puede igualar.
          </p>

          <h3 class="text-lg font-bold text-primary pt-4">¿Por qué importan para la educación?</h3>
          <ul class="space-y-2 list-none pl-0">
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 shrink-0">→</span>
              <span><strong class="text-text">Acceso universal a laboratorios:</strong> Instituciones sin laboratorio de ciencias pueden ofrecer prácticas experimentales de calidad usando simuladores web gratuitos.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 shrink-0">→</span>
              <span><strong class="text-text">Sin costo de materiales:</strong> Los experimentos virtuales no requieren reactivos, equipos ni materiales consumibles. Se pueden repetir infinitamente.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 shrink-0">→</span>
              <span><strong class="text-text">Seguridad total:</strong> Los estudiantes experimentan con electricidad, sustancias químicas o fenómenos peligrosos sin ningún riesgo.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 shrink-0">→</span>
              <span><strong class="text-text">Visualización de lo invisible:</strong> Campos eléctricos, órbitas atómicas, fuerzas gravitacionales y otros conceptos abstractos se vuelven visibles y manipulables.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 shrink-0">→</span>
              <span><strong class="text-text">Pensamiento computacional:</strong> Herramientas como Scratch y NetLogo introducen la programación como herramienta de exploración científica.</span>
            </li>
          </ul>

          <h3 class="text-lg font-bold text-primary pt-4">El rol del directivo</h3>
          <p>
            Las simulaciones son la tecnología emergente con <strong class="text-text">mayor impacto inmediato</strong>
            en la calidad del aprendizaje de ciencias y matemáticas:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
            <div class="p-4 rounded-lg border border-border bg-white">
              <h4 class="font-bold text-sm mb-1">Democratizar el acceso</h4>
              <p class="text-sm">Garantizar que todos los estudiantes tengan acceso a experiencias experimentales, independientemente de la infraestructura física de la institución.</p>
            </div>
            <div class="p-4 rounded-lg border border-border bg-white">
              <h4 class="font-bold text-sm mb-1">Alinear con el currículo</h4>
              <p class="text-sm">Asegurar que las simulaciones seleccionadas correspondan a los objetivos de aprendizaje del currículo nacional de Ecuador.</p>
            </div>
            <div class="p-4 rounded-lg border border-border bg-white">
              <h4 class="font-bold text-sm mb-1">Complementar, no reemplazar</h4>
              <p class="text-sm">Las simulaciones complementan el laboratorio real. En instituciones con laboratorio, las simulaciones sirven para preparar y reforzar las prácticas.</p>
            </div>
            <div class="p-4 rounded-lg border border-border bg-white">
              <h4 class="font-bold text-sm mb-1">Capacitar al docente</h4>
              <p class="text-sm">El docente debe saber cómo guiar la exploración del estudiante, no solo mostrar la simulación como un video. La metodología de indagación es clave.</p>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Panel: Herramientas -->
    <div role="tabpanel" id="panel-herramientas" aria-labelledby="tab-herramientas" class="tab-panel hidden">
      <section class="max-w-6xl mx-auto px-4 py-16">
        <SectionHeader
          title="Simuladores y laboratorios virtuales"
          subtitle="Herramientas gratuitas para experimentar, modelar y visualizar conceptos de ciencias, matemáticas y tecnología. Haz clic en cada herramienta para ver el detalle completo."
        />
        <!-- Filter Pills -->
        <div class="flex gap-2 mt-6 mb-8" role="radiogroup" aria-label="Filtrar herramientas">
          <button class="filter-btn active px-4 py-2 rounded-full text-sm font-semibold border-2 border-accent bg-accent text-white transition-colors" data-filter="all">
            Todas
          </button>
          <button class="filter-btn px-4 py-2 rounded-full text-sm font-semibold border-2 border-border text-text-light hover:border-violet-400 hover:text-violet-700 transition-colors" data-filter="open-source">
            Código Abierto
          </button>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 tool-grid">
          {tools.map((tool) => (
            <ToolCard {...tool} />
          ))}
        </div>
      </section>
    </div>

    <!-- Panel: Estrategia -->
    <div role="tabpanel" id="panel-estrategia" aria-labelledby="tab-estrategia" class="tab-panel hidden">
      <section class="max-w-5xl mx-auto px-4 py-16">
        <SectionHeader
          title="Estrategia de integración de simulaciones"
          subtitle="Hoja de ruta práctica para que el directivo lidere la adopción de simulaciones interactivas en su institución."
        />

        <!-- Roadmap -->
        <div class="mt-10">
          <h3 class="text-lg font-bold text-primary mb-6">Hoja de ruta por fases</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="relative p-5 rounded-xl border-2 border-accent/30 bg-accent/5">
              <div class="w-10 h-10 rounded-full bg-accent text-white font-bold flex items-center justify-center text-lg mb-3">1</div>
              <h4 class="font-bold text-sm text-primary mb-2">Identificar brechas</h4>
              <p class="text-xs text-text-light mb-3">Evaluar qué áreas de ciencias y matemáticas carecen de prácticas experimentales por falta de laboratorio, equipos o reactivos.</p>
              <div class="text-xs font-semibold text-accent">Semanas 1-2</div>
              <ul class="mt-2 space-y-1 text-xs text-text-light">
                <li class="flex items-start gap-1"><span class="text-accent shrink-0">✓</span> Reunión con docentes de Ciencias y Matemáticas</li>
                <li class="flex items-start gap-1"><span class="text-accent shrink-0">✓</span> Lista de temas que requieren experimentación</li>
                <li class="flex items-start gap-1"><span class="text-accent shrink-0">✓</span> Inventario de computadoras en laboratorio de informática</li>
              </ul>
            </div>
            <div class="relative p-5 rounded-xl border-2 border-primary/20 bg-primary/5">
              <div class="w-10 h-10 rounded-full bg-primary text-white font-bold flex items-center justify-center text-lg mb-3">2</div>
              <h4 class="font-bold text-sm text-primary mb-2">Seleccionar simuladores</h4>
              <p class="text-xs text-text-light mb-3">Elegir simulaciones que cubran los temas identificados. Priorizar las que funcionan en navegador y están en español.</p>
              <div class="text-xs font-semibold text-primary">Semanas 3-4</div>
              <ul class="mt-2 space-y-1 text-xs text-text-light">
                <li class="flex items-start gap-1"><span class="text-primary shrink-0">✓</span> Explorar el catálogo de PhET (160+ simulaciones)</li>
                <li class="flex items-start gap-1"><span class="text-primary shrink-0">✓</span> Seleccionar GeoGebra para Matemáticas</li>
                <li class="flex items-start gap-1"><span class="text-primary shrink-0">✓</span> Mapear simulaciones a unidades del currículo</li>
              </ul>
            </div>
            <div class="relative p-5 rounded-xl border-2 border-green-500/20 bg-green-50">
              <div class="w-10 h-10 rounded-full bg-green-500 text-white font-bold flex items-center justify-center text-lg mb-3">3</div>
              <h4 class="font-bold text-sm text-primary mb-2">Implementar en aula</h4>
              <p class="text-xs text-text-light mb-3">Integrar simulaciones en las planificaciones de clase. Usar metodología de indagación: predecir → experimentar → explicar.</p>
              <div class="text-xs font-semibold text-green-600">Semanas 5-10</div>
              <ul class="mt-2 space-y-1 text-xs text-text-light">
                <li class="flex items-start gap-1"><span class="text-green-500 shrink-0">✓</span> 1-2 simulaciones por unidad didáctica</li>
                <li class="flex items-start gap-1"><span class="text-green-500 shrink-0">✓</span> Guías de laboratorio virtual para cada simulación</li>
                <li class="flex items-start gap-1"><span class="text-green-500 shrink-0">✓</span> Trabajo en parejas en el laboratorio de informática</li>
              </ul>
            </div>
            <div class="relative p-5 rounded-xl border-2 border-violet-500/20 bg-violet-50">
              <div class="w-10 h-10 rounded-full bg-violet-500 text-white font-bold flex items-center justify-center text-lg mb-3">4</div>
              <h4 class="font-bold text-sm text-primary mb-2">Medir y expandir</h4>
              <p class="text-xs text-text-light mb-3">Comparar resultados de aprendizaje con y sin simulaciones. Expandir a más temas y niveles basándose en evidencia.</p>
              <div class="text-xs font-semibold text-violet-600">Semanas 11-16</div>
              <ul class="mt-2 space-y-1 text-xs text-text-light">
                <li class="flex items-start gap-1"><span class="text-violet-500 shrink-0">✓</span> Pre/post test en temas con simulación vs sin</li>
                <li class="flex items-start gap-1"><span class="text-violet-500 shrink-0">✓</span> Banco institucional de simulaciones por materia</li>
                <li class="flex items-start gap-1"><span class="text-violet-500 shrink-0">✓</span> Plan de expansión a Informática y Ed. Artística</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Decision Matrix -->
        <div class="mt-12">
          <h3 class="text-lg font-bold text-primary mb-2">Matriz de decisión: ¿Qué simulador usar?</h3>
          <p class="text-sm text-text-light mb-4">Selecciona el simulador según el área curricular y el tema específico.</p>
          <div class="overflow-x-auto rounded-xl border border-border">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-primary text-white">
                  <th class="p-3 text-left font-semibold text-xs uppercase tracking-wide">Materia / Tema</th>
                  <th class="p-3 text-left font-semibold text-xs uppercase tracking-wide">Herramienta principal</th>
                  <th class="p-3 text-left font-semibold text-xs uppercase tracking-wide">Alternativa</th>
                  <th class="p-3 text-left font-semibold text-xs uppercase tracking-wide">Nivel</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr class="bg-white">
                  <td class="p-3 font-semibold text-primary">Física (mecánica, óptica)</td>
                  <td class="p-3 text-text-light">PhET Simulations</td>
                  <td class="p-3 text-text-light">Algodoo</td>
                  <td class="p-3 text-text-light">Secundaria / Bachillerato</td>
                </tr>
                <tr class="bg-stone-50">
                  <td class="p-3 font-semibold text-primary">Electricidad y circuitos</td>
                  <td class="p-3 text-text-light">Falstad Simulator</td>
                  <td class="p-3 text-text-light">PhET, Tinkercad</td>
                  <td class="p-3 text-text-light">Secundaria / Bachillerato</td>
                </tr>
                <tr class="bg-white">
                  <td class="p-3 font-semibold text-primary">Química (lab virtual)</td>
                  <td class="p-3 text-text-light">ChemCollective</td>
                  <td class="p-3 text-text-light">PhET (reacciones)</td>
                  <td class="p-3 text-text-light">Secundaria / Bachillerato</td>
                </tr>
                <tr class="bg-stone-50">
                  <td class="p-3 font-semibold text-primary">Biología (ecosistemas)</td>
                  <td class="p-3 text-text-light">PhET, NetLogo</td>
                  <td class="p-3 text-text-light">Scratch</td>
                  <td class="p-3 text-text-light">Secundaria / Bachillerato</td>
                </tr>
                <tr class="bg-white">
                  <td class="p-3 font-semibold text-primary">Matemáticas (geometría, álgebra)</td>
                  <td class="p-3 text-text-light">GeoGebra</td>
                  <td class="p-3 text-text-light">PhET (fracciones)</td>
                  <td class="p-3 text-text-light">Primaria / Secundaria / Bachillerato</td>
                </tr>
                <tr class="bg-stone-50">
                  <td class="p-3 font-semibold text-primary">Astronomía</td>
                  <td class="p-3 text-text-light">Stellarium</td>
                  <td class="p-3 text-text-light">PhET (gravedad)</td>
                  <td class="p-3 text-text-light">Todos los niveles</td>
                </tr>
                <tr class="bg-white">
                  <td class="p-3 font-semibold text-primary">Programación / Informática</td>
                  <td class="p-3 text-text-light">Scratch</td>
                  <td class="p-3 text-text-light">GlowScript, Tinkercad</td>
                  <td class="p-3 text-text-light">Primaria / Secundaria</td>
                </tr>
                <tr class="bg-stone-50">
                  <td class="p-3 font-semibold text-primary">Diseño 3D / STEAM</td>
                  <td class="p-3 text-text-light">Tinkercad</td>
                  <td class="p-3 text-text-light">Scratch (2D)</td>
                  <td class="p-3 text-text-light">Secundaria / Bachillerato</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-xs text-text-light mt-2 italic">PhET y GeoGebra cubren la mayoría de necesidades de Ciencias y Matemáticas. Son las primeras herramientas a adoptar.</p>
        </div>

        <!-- KPIs -->
        <div class="mt-12">
          <h3 class="text-lg font-bold text-primary mb-4">Indicadores de éxito</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="p-4 rounded-xl bg-accent/5 border border-accent/20 text-center">
              <div class="text-2xl font-bold text-accent mb-1">100%</div>
              <p class="text-xs text-text-light">Estudiantes con acceso a prácticas experimentales (incluso sin laboratorio físico)</p>
            </div>
            <div class="p-4 rounded-xl bg-green-50 border border-green-200 text-center">
              <div class="text-2xl font-bold text-green-600 mb-1">2+</div>
              <p class="text-xs text-text-light">Simulaciones integradas por unidad didáctica en Ciencias y Matemáticas</p>
            </div>
            <div class="p-4 rounded-xl bg-violet-50 border border-violet-200 text-center">
              <div class="text-2xl font-bold text-violet-600 mb-1">+20%</div>
              <p class="text-xs text-text-light">Mejora en comprensión conceptual medida con pre/post test</p>
            </div>
            <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-center">
              <div class="text-2xl font-bold text-amber-600 mb-1">$0</div>
              <p class="text-xs text-text-light">Costo de implementación — todas las herramientas principales son gratuitas</p>
            </div>
          </div>
        </div>

        <!-- Hypothetical Scenario -->
        <div class="mt-12">
          <h3 class="text-lg font-bold text-primary mb-4">Escenario hipotético de implementación</h3>
          <div class="p-6 rounded-xl bg-white border border-border shadow-sm">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center shrink-0">
                <span class="text-xl" aria-hidden="true">💡</span>
              </div>
              <div>
                <h4 class="font-bold text-base text-primary mb-1">Escuela rural sin laboratorio de ciencias</h4>
                <p class="text-sm text-text-light mb-3">
                  Consideremos una escuela fiscal en zona rural que no cuenta con laboratorio de ciencias.
                  Los estudiantes de básica superior no han realizado experimentos de física o química.
                  Sin embargo, la institución dispone de un laboratorio de informática con computadoras y acceso a internet.
                </p>
                <div class="space-y-2 text-sm">
                  <p><strong class="text-text">Paso 1 — Identificar brechas:</strong> El rector podría reunirse con los docentes de Ciencias Naturales para identificar los temas del currículo que requieren práctica experimental pero se enseñan solo con libro de texto.</p>
                  <p><strong class="text-text">Paso 2 — Selección:</strong> Herramientas como <span class="font-semibold text-accent">PhET Simulations</span> (en español, gratuitas, funcionan en navegador) para física y biología, y <span class="font-semibold text-accent">ChemCollective</span> para química, permitirían mapear simulaciones a las unidades del semestre.</p>
                  <p><strong class="text-text">Paso 3 — Implementación:</strong> Los docentes podrían reservar el laboratorio de informática periódicamente. Los estudiantes trabajarían en parejas con guías de laboratorio virtual que incluyan: predicción, experimentación y explicación.</p>
                  <p><strong class="text-text">Resultado esperado:</strong> Según la literatura, el uso de simulaciones interactivas puede mejorar la comprensión de conceptos abstractos en ciencias y aumentar la motivación estudiantil, sin costo adicional al usar herramientas gratuitas.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TPACK Connection -->
        <div class="mt-12 p-6 rounded-xl bg-primary/5 border border-primary/10">
          <h3 class="font-bold text-base text-primary mb-3">Conexión con el marco TPACK</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="flex items-start gap-3">
              <span class="w-8 h-8 rounded-full bg-[#0ea5e9]/15 flex items-center justify-center text-sm font-bold text-[#0ea5e9] shrink-0">T</span>
              <div>
                <h4 class="font-semibold text-sm">Tecnológico</h4>
                <p class="text-xs text-text-light">El docente domina los simuladores: sabe configurar variables, guiar la exploración y usar las herramientas de medición integradas en cada simulación.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-8 h-8 rounded-full bg-[#8b5cf6]/15 flex items-center justify-center text-sm font-bold text-[#8b5cf6] shrink-0">P</span>
              <div>
                <h4 class="font-semibold text-sm">Pedagógico</h4>
                <p class="text-xs text-text-light">La simulación se integra en una secuencia de indagación: el estudiante predice, experimenta, observa, analiza datos y formula explicaciones. No es un video para ver pasivamente.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-8 h-8 rounded-full bg-[#10b981]/15 flex items-center justify-center text-sm font-bold text-[#10b981] shrink-0">C</span>
              <div>
                <h4 class="font-semibold text-sm">Contenido</h4>
                <p class="text-xs text-text-light">Cada simulación está vinculada directamente a un objetivo de aprendizaje del currículo: la simulación de circuitos se usa en la unidad de electricidad, no como actividad aislada.</p>
              </div>
            </div>
          </div>
        </div>

      </section>
    </div>

    <OtherTechnologies currentSlug="simulaciones" />
    <SectionNav currentSlug="simulaciones" />
  </main>
</MainLayout>

<script>
  function initTabs() {
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');
    if (!tabs.length || !panels.length) return;
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('aria-controls');
        tabs.forEach((t) => { t.setAttribute('aria-selected', 'false'); t.classList.remove('border-accent', 'text-accent'); t.classList.add('border-transparent', 'text-text-light'); });
        tab.setAttribute('aria-selected', 'true'); tab.classList.add('border-accent', 'text-accent'); tab.classList.remove('border-transparent', 'text-text-light');
        panels.forEach((p) => { p.classList.toggle('hidden', p.id !== targetId); });
      });
      tab.addEventListener('keydown', (e) => {
        const tabsArr = Array.from(tabs); const idx = tabsArr.indexOf(tab); let newIdx = idx;
        if ((e as KeyboardEvent).key === 'ArrowRight') newIdx = (idx + 1) % tabsArr.length;
        if ((e as KeyboardEvent).key === 'ArrowLeft') newIdx = (idx - 1 + tabsArr.length) % tabsArr.length;
        if (newIdx !== idx) { (tabsArr[newIdx] as HTMLElement).focus(); (tabsArr[newIdx] as HTMLElement).click(); }
      });
    });
  }
  function initFilter() {
    const filterBtns = document.querySelectorAll('.filter-btn'); const cards = document.querySelectorAll('.tool-card');
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = (btn as HTMLElement).dataset.filter;
        filterBtns.forEach((b) => { b.classList.remove('active', 'bg-accent', 'text-white', 'border-accent'); b.classList.add('border-border', 'text-text-light'); });
        btn.classList.add('active', 'bg-accent', 'text-white', 'border-accent'); btn.classList.remove('border-border', 'text-text-light');
        cards.forEach((card) => { const isOS = (card as HTMLElement).dataset.openSource === 'true'; (card as HTMLElement).style.display = (filter === 'all' || isOS) ? '' : 'none'; });
      });
    });
  }
  initTabs(); initFilter();
  document.addEventListener('astro:after-swap', () => { initTabs(); initFilter(); });
</script>
