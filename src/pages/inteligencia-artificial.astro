---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ToolCard from '../components/ToolCard.astro';
import GuideProgress from '../components/GuideProgress.astro';
import OtherTechnologies from '../components/OtherTechnologies.astro';
import SectionNav from '../components/SectionNav.astro';
import tools from '../data/tools-ia.json';
---

<MainLayout title="Inteligencia Artificial — Guía Interactiva">
  <main class="flex-1">
    <GuideProgress currentSlug="inteligencia-artificial" />
    <!-- Hero -->
    <section class="bg-primary text-white py-16 md:py-20 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-6">
          <span class="text-3xl" aria-hidden="true">🤖</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
          Inteligencia Artificial en la Educación
        </h1>
        <p class="text-base md:text-lg text-white/80 max-w-2xl mx-auto">
          Herramientas y estrategias para integrar la IA en la gestión escolar y los procesos de enseñanza-aprendizaje.
        </p>
      </div>
    </section>

    <!-- Tab Navigation -->
    <div class="sticky top-16 z-30 bg-background border-b border-border">
      <div class="max-w-4xl mx-auto px-4">
        <nav class="flex gap-1 -mb-px" role="tablist" aria-label="Secciones de Inteligencia Artificial">
          <button role="tab" aria-selected="true" aria-controls="panel-que-es" id="tab-que-es"
            class="tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-accent text-accent transition-colors">
            Qué es
          </button>
          <button role="tab" aria-selected="false" aria-controls="panel-herramientas" id="tab-herramientas"
            class="tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-text-light hover:text-text transition-colors">
            Herramientas
          </button>
          <button role="tab" aria-selected="false" aria-controls="panel-estrategia" id="tab-estrategia"
            class="tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-text-light hover:text-text transition-colors">
            Estrategia
          </button>
        </nav>
      </div>
    </div>

    <!-- Panel: Qué es -->
    <div role="tabpanel" id="panel-que-es" aria-labelledby="tab-que-es" class="tab-panel">
      <section class="max-w-4xl mx-auto px-4 py-16">
        <SectionHeader
          title="¿Qué es la Inteligencia Artificial?"
          subtitle="Una introducción clara y práctica para directivos y docentes."
        />
        <div class="space-y-4 text-text-light mt-8">
          <p>
            La <strong class="text-text">Inteligencia Artificial (IA)</strong> es un campo de la informática que
            desarrolla sistemas capaces de realizar tareas que normalmente requieren inteligencia humana:
            comprender lenguaje natural, reconocer patrones, tomar decisiones y generar contenido.
          </p>
          <p>
            En el contexto educativo, la IA no reemplaza al docente sino que se convierte en un
            <strong class="text-text">asistente poderoso</strong> que automatiza tareas repetitivas, personaliza
            el aprendizaje y proporciona datos para la toma de decisiones informada.
          </p>

          <h3 class="text-lg font-bold text-primary pt-4">¿Por qué importa para la educación?</h3>
          <ul class="space-y-2 list-none pl-0">
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 shrink-0">→</span>
              <span><strong class="text-text">Personalización:</strong> Adapta contenidos y ritmos de aprendizaje a las necesidades individuales de cada estudiante.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 shrink-0">→</span>
              <span><strong class="text-text">Eficiencia administrativa:</strong> Automatiza tareas como generación de informes, calificación y planificación.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 shrink-0">→</span>
              <span><strong class="text-text">Evaluación inteligente:</strong> Identifica brechas de aprendizaje en tiempo real y sugiere intervenciones.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 shrink-0">→</span>
              <span><strong class="text-text">Accesibilidad:</strong> Herramientas de traducción, texto a voz y generación de contenido facilitan la inclusión.</span>
            </li>
          </ul>

          <h3 class="text-lg font-bold text-primary pt-4">El rol del directivo</h3>
          <p>
            El administrador escolar es quien <strong class="text-text">habilita</strong> la adopción de IA en la institución.
            Su responsabilidad incluye:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
            <div class="p-4 rounded-lg border border-border bg-white">
              <h4 class="font-bold text-sm mb-1">Seleccionar herramientas apropiadas</h4>
              <p class="text-sm">Evaluar qué herramientas de IA se alinean con los objetivos institucionales y son accesibles para los docentes.</p>
            </div>
            <div class="p-4 rounded-lg border border-border bg-white">
              <h4 class="font-bold text-sm mb-1">Establecer políticas de uso</h4>
              <p class="text-sm">Definir lineamientos claros sobre el uso ético y responsable de la IA por parte de docentes y estudiantes.</p>
            </div>
            <div class="p-4 rounded-lg border border-border bg-white">
              <h4 class="font-bold text-sm mb-1">Facilitar la capacitación</h4>
              <p class="text-sm">Organizar talleres y sesiones de formación para que los docentes desarrollen competencias en IA educativa.</p>
            </div>
            <div class="p-4 rounded-lg border border-border bg-white">
              <h4 class="font-bold text-sm mb-1">Monitorear el impacto</h4>
              <p class="text-sm">Recopilar datos sobre cómo la IA está afectando los resultados de aprendizaje y la carga laboral docente.</p>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Panel: Herramientas -->
    <div role="tabpanel" id="panel-herramientas" aria-labelledby="tab-herramientas" class="tab-panel hidden">
      <section class="max-w-6xl mx-auto px-4 py-16">
        <SectionHeader
          title="Herramientas de IA para educación"
          subtitle="Catálogo de herramientas accesibles para integrar la inteligencia artificial en tu institución educativa. Haz clic en cada herramienta para ver el detalle completo."
        />
        <!-- Filter Pills -->
        <div class="flex gap-2 mt-6 mb-8" role="radiogroup" aria-label="Filtrar herramientas">
          <button class="filter-btn active px-4 py-2 rounded-full text-sm font-semibold border-2 border-accent bg-accent text-white transition-colors" data-filter="all">
            Todas
          </button>
          <button class="filter-btn px-4 py-2 rounded-full text-sm font-semibold border-2 border-border text-text-light hover:border-violet-400 hover:text-violet-700 transition-colors" data-filter="open-source">
            Código Abierto
          </button>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 tool-grid">
          {tools.map((tool) => (
            <ToolCard {...tool} />
          ))}
        </div>
      </section>
    </div>

    <!-- Panel: Estrategia -->
    <div role="tabpanel" id="panel-estrategia" aria-labelledby="tab-estrategia" class="tab-panel hidden">
      <section class="max-w-5xl mx-auto px-4 py-16">
        <SectionHeader
          title="Estrategia de integración de IA"
          subtitle="Hoja de ruta práctica para que directivos y docentes lideren la adopción de inteligencia artificial en su institución."
        />

        <!-- Roadmap -->
        <div class="mt-10">
          <h3 class="text-lg font-bold text-primary mb-6">Hoja de ruta por fases</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="relative p-5 rounded-xl border-2 border-accent/30 bg-accent/5">
              <div class="w-10 h-10 rounded-full bg-accent text-white font-bold flex items-center justify-center text-lg mb-3">1</div>
              <h4 class="font-bold text-sm text-primary mb-2">Diagnosticar</h4>
              <p class="text-xs text-text-light mb-3">Evaluar las competencias digitales del equipo docente y la infraestructura tecnológica disponible.</p>
              <div class="text-xs font-semibold text-accent">Sesiones 1-3 (Semana 1)</div>
              <ul class="mt-2 space-y-1 text-xs text-text-light">
                <li class="flex items-start gap-1"><span class="text-accent shrink-0">✓</span> Encuesta de competencias digitales</li>
                <li class="flex items-start gap-1"><span class="text-accent shrink-0">✓</span> Inventario de dispositivos y conectividad</li>
                <li class="flex items-start gap-1"><span class="text-accent shrink-0">✓</span> Reunión con coordinadores de área</li>
              </ul>
            </div>
            <div class="relative p-5 rounded-xl border-2 border-primary/20 bg-primary/5">
              <div class="w-10 h-10 rounded-full bg-primary text-white font-bold flex items-center justify-center text-lg mb-3">2</div>
              <h4 class="font-bold text-sm text-primary mb-2">Planificar</h4>
              <p class="text-xs text-text-light mb-3">Seleccionar herramientas del catálogo, definir políticas de uso ético y diseñar el plan de capacitación.</p>
              <div class="text-xs font-semibold text-primary">Sesiones 4-6 (Semana 2)</div>
              <ul class="mt-2 space-y-1 text-xs text-text-light">
                <li class="flex items-start gap-1"><span class="text-primary shrink-0">✓</span> Elegir 2-3 herramientas alineadas a necesidades</li>
                <li class="flex items-start gap-1"><span class="text-primary shrink-0">✓</span> Redactar política institucional de IA</li>
                <li class="flex items-start gap-1"><span class="text-primary shrink-0">✓</span> Programar talleres de capacitación</li>
              </ul>
            </div>
            <div class="relative p-5 rounded-xl border-2 border-green-500/20 bg-green-50">
              <div class="w-10 h-10 rounded-full bg-green-500 text-white font-bold flex items-center justify-center text-lg mb-3">3</div>
              <h4 class="font-bold text-sm text-primary mb-2">Implementar</h4>
              <p class="text-xs text-text-light mb-3">Ejecutar el piloto con docentes voluntarios, acompañar la integración en el aula y documentar experiencias.</p>
              <div class="text-xs font-semibold text-green-600">Sesiones 7-9 (Semana 3)</div>
              <ul class="mt-2 space-y-1 text-xs text-text-light">
                <li class="flex items-start gap-1"><span class="text-green-500 shrink-0">✓</span> Piloto con 3-5 docentes voluntarios</li>
                <li class="flex items-start gap-1"><span class="text-green-500 shrink-0">✓</span> Acompañamiento semanal en aula</li>
                <li class="flex items-start gap-1"><span class="text-green-500 shrink-0">✓</span> Bitácora de experiencias y desafíos</li>
              </ul>
            </div>
            <div class="relative p-5 rounded-xl border-2 border-violet-500/20 bg-violet-50">
              <div class="w-10 h-10 rounded-full bg-violet-500 text-white font-bold flex items-center justify-center text-lg mb-3">4</div>
              <h4 class="font-bold text-sm text-primary mb-2">Evaluar y escalar</h4>
              <p class="text-xs text-text-light mb-3">Medir resultados del piloto, ajustar la estrategia y expandir gradualmente a más docentes y áreas.</p>
              <div class="text-xs font-semibold text-violet-600">Sesiones 10-12 (Semana 4)</div>
              <ul class="mt-2 space-y-1 text-xs text-text-light">
                <li class="flex items-start gap-1"><span class="text-violet-500 shrink-0">✓</span> Encuesta de satisfacción a docentes y estudiantes</li>
                <li class="flex items-start gap-1"><span class="text-violet-500 shrink-0">✓</span> Análisis de impacto en aprendizaje</li>
                <li class="flex items-start gap-1"><span class="text-violet-500 shrink-0">✓</span> Plan de escalamiento para el siguiente periodo</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Decision Matrix -->
        <div class="mt-12">
          <h3 class="text-lg font-bold text-primary mb-2">Matriz de decisión: ¿Qué herramienta usar?</h3>
          <p class="text-sm text-text-light mb-4">Selecciona la herramienta según el área curricular y el nivel de competencia digital del docente.</p>
          <div class="overflow-x-auto rounded-xl border border-border">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-primary text-white">
                  <th class="p-3 text-left font-semibold text-xs uppercase tracking-wide">Materia</th>
                  <th class="p-3 text-left font-semibold text-xs uppercase tracking-wide">Nivel Básico</th>
                  <th class="p-3 text-left font-semibold text-xs uppercase tracking-wide">Nivel Intermedio</th>
                  <th class="p-3 text-left font-semibold text-xs uppercase tracking-wide">Nivel Avanzado</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr class="bg-white">
                  <td class="p-3 font-semibold text-primary">Lengua y Literatura</td>
                  <td class="p-3 text-text-light">Canva, Diffit</td>
                  <td class="p-3 text-text-light">ChatGPT, Curipod</td>
                  <td class="p-3 text-text-light">Hugging Chat, LibreChat</td>
                </tr>
                <tr class="bg-stone-50">
                  <td class="p-3 font-semibold text-primary">Matemáticas</td>
                  <td class="p-3 text-text-light">Kahoot!</td>
                  <td class="p-3 text-text-light">ChatGPT, Formative</td>
                  <td class="p-3 text-text-light">Open WebUI</td>
                </tr>
                <tr class="bg-white">
                  <td class="p-3 font-semibold text-primary">Ciencias Naturales</td>
                  <td class="p-3 text-text-light">Diffit, Kahoot!</td>
                  <td class="p-3 text-text-light">ChatGPT, Gemini</td>
                  <td class="p-3 text-text-light">Jan (sin internet)</td>
                </tr>
                <tr class="bg-stone-50">
                  <td class="p-3 font-semibold text-primary">Estudios Sociales</td>
                  <td class="p-3 text-text-light">Canva, Curipod</td>
                  <td class="p-3 text-text-light">ChatGPT, Gemini</td>
                  <td class="p-3 text-text-light">Hugging Chat</td>
                </tr>
                <tr class="bg-white">
                  <td class="p-3 font-semibold text-primary">Inglés</td>
                  <td class="p-3 text-text-light">Quillbot</td>
                  <td class="p-3 text-text-light">ChatGPT, Gemini</td>
                  <td class="p-3 text-text-light">LibreChat</td>
                </tr>
                <tr class="bg-stone-50">
                  <td class="p-3 font-semibold text-primary">Ed. Artística</td>
                  <td class="p-3 text-text-light">Canva con IA</td>
                  <td class="p-3 text-text-light">Canva + ChatGPT</td>
                  <td class="p-3 text-text-light">Open WebUI + imágenes</td>
                </tr>
                <tr class="bg-white">
                  <td class="p-3 font-semibold text-primary">Informática</td>
                  <td class="p-3 text-text-light">ChatGPT</td>
                  <td class="p-3 text-text-light">Hugging Chat, Jan</td>
                  <td class="p-3 text-text-light">LibreChat, Open WebUI</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-xs text-text-light mt-2 italic">Nivel Básico: el docente usa herramientas digitales básicas (email, navegador). Intermedio: usa plataformas educativas. Avanzado: puede instalar software y resolver problemas técnicos.</p>
        </div>

        <!-- KPIs -->
        <div class="mt-12">
          <h3 class="text-lg font-bold text-primary mb-4">Indicadores de éxito</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="p-4 rounded-xl bg-accent/5 border border-accent/20 text-center">
              <div class="text-2xl font-bold text-accent mb-1">70%</div>
              <p class="text-xs text-text-light">Docentes capacitados en al menos una herramienta de IA al final del semestre</p>
            </div>
            <div class="p-4 rounded-xl bg-green-50 border border-green-200 text-center">
              <div class="text-2xl font-bold text-green-600 mb-1">3+</div>
              <p class="text-xs text-text-light">Herramientas de IA integradas en planificaciones de clase regulares</p>
            </div>
            <div class="p-4 rounded-xl bg-violet-50 border border-violet-200 text-center">
              <div class="text-2xl font-bold text-violet-600 mb-1">80%</div>
              <p class="text-xs text-text-light">Satisfacción docente con las herramientas de IA adoptadas</p>
            </div>
            <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-center">
              <div class="text-2xl font-bold text-amber-600 mb-1">+15%</div>
              <p class="text-xs text-text-light">Mejora en indicadores de aprendizaje en áreas piloto (pre/post test)</p>
            </div>
          </div>
        </div>

        <!-- Hypothetical Scenario -->
        <div class="mt-12">
          <h3 class="text-lg font-bold text-primary mb-4">Escenario hipotético de implementación</h3>
          <div class="p-6 rounded-xl bg-white border border-border shadow-sm">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center shrink-0">
                <span class="text-xl" aria-hidden="true">💡</span>
              </div>
              <div>
                <h4 class="font-bold text-base text-primary mb-1">Colegio urbano con docentes que dedican mucho tiempo a crear materiales diferenciados</h4>
                <p class="text-sm text-text-light mb-3">
                  Consideremos una institución educativa donde los docentes dedican varias horas semanales a crear materiales
                  diferenciados para estudiantes con distintos niveles de comprensión lectora. La mayoría del equipo docente
                  no ha utilizado herramientas de IA previamente, pero cuenta con acceso a computadora y WiFi.
                </p>
                <div class="space-y-2 text-sm">
                  <p><strong class="text-text">Paso 1 — Diagnóstico:</strong> El coordinador académico podría encuestar a los docentes para conocer su nivel de competencia digital y las tareas que más tiempo les demandan.</p>
                  <p><strong class="text-text">Paso 2 — Selección:</strong> Herramientas como <span class="font-semibold text-accent">Diffit</span> para diferenciación de textos y <span class="font-semibold text-accent">Kahoot!</span> para evaluación formativa rápida serían opciones gratuitas que solo requieren un navegador.</p>
                  <p><strong class="text-text">Paso 3 — Piloto:</strong> Un grupo reducido de docentes voluntarios podría probar las herramientas durante un periodo de 4 a 6 semanas, con acompañamiento semanal por parte del coordinador.</p>
                  <p><strong class="text-text">Resultado esperado:</strong> Según la literatura, las herramientas de IA generativa pueden reducir significativamente el tiempo de preparación de materiales y facilitar la diferenciación pedagógica, lo que a su vez puede mejorar los resultados de aprendizaje.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TPACK Connection -->
        <div class="mt-12 p-6 rounded-xl bg-primary/5 border border-primary/10">
          <h3 class="font-bold text-base text-primary mb-3">Conexión con el marco TPACK</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="flex items-start gap-3">
              <span class="w-8 h-8 rounded-full bg-[#0ea5e9]/15 flex items-center justify-center text-sm font-bold text-[#0ea5e9] shrink-0">T</span>
              <div>
                <h4 class="font-semibold text-sm">Tecnológico</h4>
                <p class="text-xs text-text-light">El docente domina las herramientas de IA del catálogo: sabe crear prompts efectivos, generar contenido y evaluar la calidad de las respuestas.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-8 h-8 rounded-full bg-[#8b5cf6]/15 flex items-center justify-center text-sm font-bold text-[#8b5cf6] shrink-0">P</span>
              <div>
                <h4 class="font-semibold text-sm">Pedagógico</h4>
                <p class="text-xs text-text-light">La IA se integra en estrategias pedagógicas activas: pensamiento crítico al evaluar respuestas de IA, aprendizaje diferenciado, evaluación formativa.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-8 h-8 rounded-full bg-[#10b981]/15 flex items-center justify-center text-sm font-bold text-[#10b981] shrink-0">C</span>
              <div>
                <h4 class="font-semibold text-sm">Contenido</h4>
                <p class="text-xs text-text-light">Las herramientas se aplican al contenido curricular específico de cada materia, generando materiales alineados con los objetivos de aprendizaje.</p>
              </div>
            </div>
          </div>
        </div>

      </section>
    </div>

    <OtherTechnologies currentSlug="inteligencia-artificial" />
    <SectionNav currentSlug="inteligencia-artificial" />
  </main>
</MainLayout>

<script>
  function initTabs() {
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');
    if (!tabs.length || !panels.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('aria-controls');
        tabs.forEach((t) => {
          t.setAttribute('aria-selected', 'false');
          t.classList.remove('border-accent', 'text-accent');
          t.classList.add('border-transparent', 'text-text-light');
        });
        tab.setAttribute('aria-selected', 'true');
        tab.classList.add('border-accent', 'text-accent');
        tab.classList.remove('border-transparent', 'text-text-light');
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.id !== targetId);
        });
      });

      tab.addEventListener('keydown', (e) => {
        const tabsArr = Array.from(tabs);
        const idx = tabsArr.indexOf(tab);
        let newIdx = idx;
        if ((e as KeyboardEvent).key === 'ArrowRight') newIdx = (idx + 1) % tabsArr.length;
        if ((e as KeyboardEvent).key === 'ArrowLeft') newIdx = (idx - 1 + tabsArr.length) % tabsArr.length;
        if (newIdx !== idx) {
          (tabsArr[newIdx] as HTMLElement).focus();
          (tabsArr[newIdx] as HTMLElement).click();
        }
      });
    });
  }

  function initFilter() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.tool-card');
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = (btn as HTMLElement).dataset.filter;

        filterBtns.forEach((b) => {
          b.classList.remove('active', 'bg-accent', 'text-white', 'border-accent');
          b.classList.add('border-border', 'text-text-light');
        });
        btn.classList.add('active', 'bg-accent', 'text-white', 'border-accent');
        btn.classList.remove('border-border', 'text-text-light');

        cards.forEach((card) => {
          const isOpenSource = (card as HTMLElement).dataset.openSource === 'true';
          if (filter === 'all') {
            (card as HTMLElement).style.display = '';
          } else if (filter === 'open-source') {
            (card as HTMLElement).style.display = isOpenSource ? '' : 'none';
          }
        });
      });
    });
  }

  initTabs();
  initFilter();
  document.addEventListener('astro:after-swap', () => {
    initTabs();
    initFilter();
  });
</script>
