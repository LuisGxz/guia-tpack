---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
const base = import.meta.env.BASE_URL;
---

<MainLayout title="Tech in Class — Tecnología para tu Institución Educativa">
  <main class="flex-1">
    <!-- Hero -->
    <section class="bg-primary text-white py-16 md:py-24 px-4 overflow-hidden">
      <div class="max-w-6xl mx-auto flex flex-col lg:flex-row items-center gap-10 lg:gap-16">
        <!-- Text -->
        <div class="flex-1 text-center lg:text-left">
          <p class="text-accent-light text-sm md:text-base font-semibold uppercase tracking-wider mb-4">
            Informe de investigación
          </p>
          <h1 class="text-3xl md:text-5xl font-bold text-white mb-5 leading-tight">
            Transforma tu institución educativa con tecnología
          </h1>
          <p class="text-base md:text-lg text-white/80 max-w-2xl mx-auto lg:mx-0 mb-10">
            Descubre cómo integrar Inteligencia Artificial, Realidad Virtual, Realidad Aumentada
            y Simulaciones Interactivas en tu escuela. Una guía paso a paso diseñada para
            directivos y docentes, con herramientas gratuitas y estrategias probadas.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <a
              href="#explorar"
              class="inline-block bg-accent hover:bg-accent-light text-white font-semibold px-8 py-3 rounded-lg transition-colors"
            >
              Comenzar
            </a>
            <a
              href={`${base}tpack/`}
              class="inline-block border border-white/30 hover:bg-white/10 text-white font-semibold px-8 py-3 rounded-lg transition-colors"
            >
              ¿Qué es TPACK?
            </a>
          </div>
        </div>
        <!-- Hero Illustration -->
        <div class="flex-shrink-0 w-full max-w-xs sm:max-w-sm lg:max-w-md" aria-hidden="true">
          <svg viewBox="0 0 400 350" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto drop-shadow-2xl">
            <!-- Background glow -->
            <circle cx="200" cy="175" r="140" fill="#0ea5e9" opacity="0.06"/>
            <circle cx="200" cy="175" r="100" fill="#0ea5e9" opacity="0.04"/>
            <!-- Laptop base -->
            <rect x="95" y="120" width="210" height="140" rx="10" fill="#1e3a5f" stroke="white" stroke-width="2" opacity="0.9"/>
            <rect x="105" y="130" width="190" height="110" rx="6" fill="#0f2440"/>
            <!-- Screen content lines -->
            <rect x="120" y="148" width="80" height="6" rx="3" fill="#0ea5e9" opacity="0.7"/>
            <rect x="120" y="162" width="60" height="4" rx="2" fill="white" opacity="0.25"/>
            <rect x="120" y="172" width="70" height="4" rx="2" fill="white" opacity="0.2"/>
            <rect x="120" y="182" width="50" height="4" rx="2" fill="white" opacity="0.15"/>
            <!-- Screen chart -->
            <rect x="215" y="148" width="65" height="70" rx="4" fill="white" opacity="0.08"/>
            <rect x="222" y="195" width="8" height="18" rx="2" fill="#0ea5e9" opacity="0.6"/>
            <rect x="235" y="185" width="8" height="28" rx="2" fill="#0ea5e9" opacity="0.8"/>
            <rect x="248" y="175" width="8" height="38" rx="2" fill="#0ea5e9"/>
            <rect x="261" y="165" width="8" height="48" rx="2" fill="#38bdf8"/>
            <!-- Laptop keyboard base -->
            <path d="M80 260L95 260L95 260L305 260L320 260L335 275C335 278 332 280 329 280H71C68 280 65 278 65 275L80 260Z" fill="#1e3a5f" stroke="white" stroke-width="1.5" opacity="0.85"/>
            <!-- Floating AI brain icon (top-left) -->
            <g transform="translate(50, 70)">
              <circle cx="25" cy="25" r="25" fill="white" opacity="0.12"/>
              <circle cx="25" cy="25" r="20" fill="white" opacity="0.1"/>
              <path d="M25 12C19 12 14 16.5 14 22C14 24.5 15 26.8 16.7 28.5C16.2 30.8 15 33 15 33C15 33 18.5 32 20.5 30.5C21.9 31.1 23.4 31.5 25 31.5C31 31.5 36 27 36 22C36 16.5 31 12 25 12Z" stroke="#0ea5e9" stroke-width="1.8" fill="none"/>
              <circle cx="21" cy="21" r="1.5" fill="#0ea5e9"/>
              <circle cx="29" cy="21" r="1.5" fill="#0ea5e9"/>
              <circle cx="25" cy="25" r="1.5" fill="#0ea5e9"/>
              <path d="M21 21L25 25L29 21" stroke="#0ea5e9" stroke-width="0.8" opacity="0.6"/>
            </g>
            <!-- Floating VR headset icon (top-right) -->
            <g transform="translate(310, 60)">
              <circle cx="25" cy="25" r="25" fill="white" opacity="0.12"/>
              <rect x="10" y="18" width="30" height="16" rx="5" stroke="#38bdf8" stroke-width="1.8" fill="none"/>
              <circle cx="19" cy="26" r="4" stroke="#38bdf8" stroke-width="1.2" fill="none"/>
              <circle cx="31" cy="26" r="4" stroke="#38bdf8" stroke-width="1.2" fill="none"/>
              <path d="M8 22C6 20 6 18 8 16" stroke="#38bdf8" stroke-width="1.2" stroke-linecap="round"/>
              <path d="M42 22C44 20 44 18 42 16" stroke="#38bdf8" stroke-width="1.2" stroke-linecap="round"/>
            </g>
            <!-- Floating phone/AR icon (right) -->
            <g transform="translate(330, 170)">
              <circle cx="22" cy="22" r="22" fill="white" opacity="0.12"/>
              <rect x="12" y="8" width="20" height="30" rx="3" stroke="#38bdf8" stroke-width="1.5" fill="none"/>
              <circle cx="22" cy="34" r="1.5" fill="#38bdf8" opacity="0.6"/>
              <rect x="16" y="14" width="12" height="12" rx="1" stroke="#0ea5e9" stroke-width="1" fill="none" stroke-dasharray="2 2"/>
              <circle cx="22" cy="20" r="2" fill="#0ea5e9" opacity="0.7"/>
            </g>
            <!-- Floating book icon (left) -->
            <g transform="translate(20, 190)">
              <circle cx="22" cy="22" r="22" fill="white" opacity="0.12"/>
              <path d="M12 14C12 14 16 12 22 12C28 12 32 14 32 14V32C32 32 28 30 22 30C16 30 12 32 12 32V14Z" stroke="#38bdf8" stroke-width="1.5" fill="none"/>
              <path d="M22 12V30" stroke="#38bdf8" stroke-width="1" opacity="0.5"/>
            </g>
            <!-- Floating lightbulb (top-center) -->
            <g transform="translate(175, 30)">
              <circle cx="20" cy="20" r="18" fill="white" opacity="0.1"/>
              <path d="M20 8C14.5 8 10 12.5 10 18C10 21.5 12 24.5 15 26V30H25V26C28 24.5 30 21.5 30 18C30 12.5 25.5 8 20 8Z" stroke="#fbbf24" stroke-width="1.5" fill="none"/>
              <path d="M16 30H24" stroke="#fbbf24" stroke-width="1.2" stroke-linecap="round"/>
              <path d="M17 33H23" stroke="#fbbf24" stroke-width="1.2" stroke-linecap="round"/>
            </g>
            <!-- Connection dots / particles -->
            <circle cx="135" cy="95" r="3" fill="#0ea5e9" opacity="0.4"/>
            <circle cx="280" cy="105" r="2" fill="#38bdf8" opacity="0.5"/>
            <circle cx="60" cy="145" r="2.5" fill="#0ea5e9" opacity="0.3"/>
            <circle cx="350" cy="140" r="2" fill="#38bdf8" opacity="0.4"/>
            <circle cx="155" cy="310" r="2" fill="#0ea5e9" opacity="0.3"/>
            <circle cx="270" cy="300" r="3" fill="#38bdf8" opacity="0.25"/>
            <!-- Dashed connection lines -->
            <path d="M75 95L135 95" stroke="#0ea5e9" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.2"/>
            <path d="M280 105L335 85" stroke="#0ea5e9" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.2"/>
            <path d="M42 212L60 145" stroke="#0ea5e9" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.15"/>
          </svg>
        </div>
      </div>
    </section>

    <!-- Objective -->
    <section class="max-w-4xl mx-auto px-4 py-16 animate-on-scroll">
      <SectionHeader
        title="Objetivo de la guía"
        subtitle="Proporcionar a directivos y docentes una herramienta práctica y accesible para liderar e implementar la integración de tecnologías emergentes en sus instituciones educativas."
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8 animate-on-scroll stagger">
        <div class="text-center p-6">
          <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl" aria-hidden="true">🎯</span>
          </div>
          <h3 class="font-bold text-base mb-2">Orientar</h3>
          <p class="text-text-light text-sm">Guiar el proceso de toma de decisiones sobre qué tecnologías adoptar y cómo implementarlas.</p>
        </div>
        <div class="text-center p-6">
          <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl" aria-hidden="true">🔧</span>
          </div>
          <h3 class="font-bold text-base mb-2">Equipar</h3>
          <p class="text-text-light text-sm">Ofrecer un catálogo de herramientas gratuitas y estrategias de integración basadas en el marco TPACK.</p>
        </div>
        <div class="text-center p-6">
          <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl" aria-hidden="true">📋</span>
          </div>
          <h3 class="font-bold text-base mb-2">Planificar</h3>
          <p class="text-text-light text-sm">Proveer un plan de implementación por fases adaptable a la realidad de cada institución.</p>
        </div>
      </div>
    </section>

    <!-- Target Audience -->
    <section class="bg-white py-16 px-4">
      <div class="max-w-4xl mx-auto">
        <SectionHeader
          title="¿A quién está dirigida?"
          subtitle="Esta guía fue diseñada para directivos y docentes que impulsan la innovación educativa en sus instituciones."
        />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8 animate-on-scroll stagger">
          <div class="flex items-start gap-4 p-5 rounded-xl border border-border bg-background">
            <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
              <span class="text-xl" aria-hidden="true">👤</span>
            </div>
            <div>
              <h3 class="font-bold text-base mb-1">Directores escolares</h3>
              <p class="text-text-light text-sm">Responsables de la visión estratégica y la toma de decisiones institucionales sobre adopción tecnológica.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-5 rounded-xl border border-border bg-background">
            <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
              <span class="text-xl" aria-hidden="true">👥</span>
            </div>
            <div>
              <h3 class="font-bold text-base mb-1">Coordinadores de área</h3>
              <p class="text-text-light text-sm">Líderes pedagógicos que coordinan la implementación de nuevas herramientas y capacitan a los docentes.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-5 rounded-xl border border-border bg-background">
            <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
              <span class="text-xl" aria-hidden="true">🏫</span>
            </div>
            <div>
              <h3 class="font-bold text-base mb-1">Instituciones educativas</h3>
              <p class="text-text-light text-sm">Aplicable a instituciones educativas a nivel mundial. Enfocada en centros con recursos tecnológicos moderados.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-5 rounded-xl border border-border bg-background">
            <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
              <span class="text-xl" aria-hidden="true">📚</span>
            </div>
            <div>
              <h3 class="font-bold text-base mb-1">Docentes</h3>
              <p class="text-text-light text-sm">Protagonistas de la integración tecnológica en el aula. Aplican directamente las herramientas y estrategias pedagógicas propuestas en esta guía.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Navigation Cards -->
    <section id="explorar" class="max-w-6xl mx-auto px-4 py-16">
      <SectionHeader
        title="Explora la guía"
        subtitle="Navega por cada sección para conocer las tecnologías, el marco pedagógico y el plan de acción."
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8 animate-on-scroll stagger">
        <a href={`${base}tpack/`} class="group block p-6 rounded-xl border border-border bg-white shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all">
          <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
            <span class="text-2xl" aria-hidden="true">🔬</span>
          </div>
          <h3 class="text-lg font-bold mb-2 group-hover:text-accent transition-colors">Marco TPACK</h3>
          <p class="text-text-light text-sm">Conoce el marco pedagógico que fundamenta la integración tecnológica en la educación.</p>
        </a>
        <a href={`${base}inteligencia-artificial/`} class="group block p-6 rounded-xl border border-border bg-white shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <span class="text-2xl" aria-hidden="true">🤖</span>
          </div>
          <h3 class="text-lg font-bold mb-2 group-hover:text-accent transition-colors">Inteligencia Artificial</h3>
          <p class="text-text-light text-sm">Herramientas de IA gratuitas y estrategias para transformar la enseñanza y la gestión escolar.</p>
        </a>
        <a href={`${base}realidad-virtual/`} class="group block p-6 rounded-xl border border-border bg-white shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all">
          <div class="w-12 h-12 bg-cyan-100 rounded-lg flex items-center justify-center mb-4">
            <span class="text-2xl" aria-hidden="true">🥽</span>
          </div>
          <h3 class="text-lg font-bold mb-2 group-hover:text-accent transition-colors">Realidad Virtual</h3>
          <p class="text-text-light text-sm">Experiencias inmersivas que permiten explorar lugares y conceptos de forma vivencial.</p>
        </a>
        <a href={`${base}realidad-aumentada/`} class="group block p-6 rounded-xl border border-border bg-white shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all">
          <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center mb-4">
            <span class="text-2xl" aria-hidden="true">📱</span>
          </div>
          <h3 class="text-lg font-bold mb-2 group-hover:text-accent transition-colors">Realidad Aumentada</h3>
          <p class="text-text-light text-sm">Superpone contenido digital al mundo real para enriquecer el aprendizaje presencial.</p>
        </a>
        <a href={`${base}simulaciones/`} class="group block p-6 rounded-xl border border-border bg-white shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all">
          <div class="w-12 h-12 bg-amber-100 rounded-lg flex items-center justify-center mb-4">
            <span class="text-2xl" aria-hidden="true">🧪</span>
          </div>
          <h3 class="text-lg font-bold mb-2 group-hover:text-accent transition-colors">Simulaciones Interactivas</h3>
          <p class="text-text-light text-sm">Laboratorios virtuales y simuladores que permiten experimentar sin riesgo ni costo de materiales.</p>
        </a>
        <a href={`${base}plan-implementacion/`} class="group block p-6 rounded-xl border border-border bg-white shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all">
          <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-4">
            <span class="text-2xl" aria-hidden="true">📝</span>
          </div>
          <h3 class="text-lg font-bold mb-2 group-hover:text-accent transition-colors">Plan de Implementación</h3>
          <p class="text-text-light text-sm">Un plan por fases para adoptar estas tecnologías de forma ordenada y sostenible.</p>
        </a>
      </div>
    </section>
  </main>
</MainLayout>
