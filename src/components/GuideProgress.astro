---
const base = import.meta.env.BASE_URL;

interface Props {
  currentSlug: string;
}

const steps = [
  { slug: 'tpack', short: 'TPACK', icon: '🔬' },
  { slug: 'inteligencia-artificial', short: 'IA', icon: '🤖' },
  { slug: 'realidad-virtual', short: 'RV', icon: '🥽' },
  { slug: 'realidad-aumentada', short: 'RA', icon: '📱' },
  { slug: 'simulaciones', short: 'Sim', icon: '🧪' },
  { slug: 'plan-implementacion', short: 'Plan', icon: '📝' },
  { slug: 'ejemplos-practicos', short: 'Ejemplos', icon: '💡' },
];

const { currentSlug } = Astro.props;
const currentIdx = steps.findIndex((s) => s.slug === currentSlug);
