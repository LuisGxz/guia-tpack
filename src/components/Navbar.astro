---
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const links = [
  { href: base, label: 'Inicio' },
  { href: `${base}tpack/`, label: 'TPACK' },
  { href: `${base}inteligencia-artificial/`, label: 'IA' },
  { href: `${base}realidad-virtual/`, label: 'RV' },
  { href: `${base}realidad-aumentada/`, label: 'RA' },
  { href: `${base}plan-implementacion/`, label: 'Plan' },
  { href: `${base}referencias/`, label: 'Referencias' },
];
---

<header class="sticky top-0 z-50 bg-primary shadow-md">
  <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logo / Brand -->
    <a href={base} class="text-white font-heading font-bold text-lg leading-tight hover:text-accent-light transition-colors">
      Guía TEE
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-1">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'px-3 py-2 rounded-md text-sm font-semibold transition-colors',
              currentPath === href
                ? 'bg-white/15 text-accent-light'
                : 'text-white/85 hover:bg-white/10 hover:text-white',
            ]}
            aria-current={currentPath === href ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Hamburger button (mobile) -->
    <button
      id="menu-toggle"
      class="md:hidden flex items-center justify-center w-12 h-12 text-white"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>
</header>

<style>
  .font-heading {
    font-family: var(--font-heading);
  }
</style>
