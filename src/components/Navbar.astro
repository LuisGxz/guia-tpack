---
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

interface Props {
  activeSection?: string;
}

const { activeSection } = Astro.props;

const links = [
  { href: base, label: 'Inicio', slug: '' },
  { href: `${base}tpack/`, label: 'TPACK', slug: 'tpack' },
  { href: `${base}inteligencia-artificial/`, label: 'IA', slug: 'inteligencia-artificial' },
  { href: `${base}realidad-virtual/`, label: 'RV', slug: 'realidad-virtual' },
  { href: `${base}realidad-aumentada/`, label: 'RA', slug: 'realidad-aumentada' },
  { href: `${base}simulaciones/`, label: 'Simulaciones', slug: 'simulaciones' },
  { href: `${base}plan-implementacion/`, label: 'Plan', slug: 'plan-implementacion' },
  { href: `${base}ejemplos-practicos/`, label: 'Ejemplos', slug: 'ejemplos-practicos' },
  { href: `${base}referencias/`, label: 'Referencias', slug: 'referencias' },
];

function isActive(link: { href: string; slug: string }) {
  if (currentPath === link.href) return true;
  if (activeSection && link.slug === activeSection) return true;
  return false;
}
---

<header class="sticky top-0 z-50 bg-primary shadow-md">
  <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logo / Brand -->
    <a href={base} class="flex items-center gap-2.5 text-white font-heading font-bold text-lg leading-tight hover:text-accent-light transition-colors">
      <div class="w-9 h-9 rounded-lg bg-white/15 flex items-center justify-center shrink-0">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M4 19.5C4 18.837 4.263 18.201 4.732 17.732C5.201 17.263 5.837 17 6.5 17H20" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M6.5 2H20V22H6.5C5.837 22 5.201 21.737 4.732 21.268C4.263 20.799 4 20.163 4 19.5V4.5C4 3.837 4.263 3.201 4.732 2.732C5.201 2.263 5.837 2 6.5 2Z" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="12" cy="10" r="2" fill="#0ea5e9"/>
          <circle cx="16" cy="8" r="1.2" fill="#0ea5e9" opacity="0.7"/>
          <circle cx="10" cy="13.5" r="1" fill="#0ea5e9" opacity="0.5"/>
          <path d="M12 10L16 8" stroke="#0ea5e9" stroke-width="0.8" opacity="0.6"/>
          <path d="M12 10L10 13.5" stroke="#0ea5e9" stroke-width="0.8" opacity="0.6"/>
        </svg>
      </div>
      Tech in Class
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-1">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'px-3 py-2 rounded-md text-sm font-semibold transition-colors',
              isActive(link)
                ? 'bg-white/15 text-accent-light'
                : 'text-white/85 hover:bg-white/10 hover:text-white',
            ]}
            aria-current={isActive(link) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Hamburger button (mobile) -->
    <button
      id="menu-toggle"
      class="md:hidden flex items-center justify-center w-12 h-12 text-white"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>
</header>

<style>
  .font-heading {
    font-family: var(--font-heading);
  }
</style>
