---
interface Props {
  name: string;
  description: string;
  url: string;
  category: string;
  icon: string;
  free: boolean;
}

const { name, description, url, category, icon, free } = Astro.props;

const categoryColors: Record<string, string> = {
  'Creación de contenido': 'bg-blue-100 text-blue-800',
  'Evaluación': 'bg-green-100 text-green-800',
  'Capacitación': 'bg-purple-100 text-purple-800',
  'Experiencias inmersivas': 'bg-orange-100 text-orange-800',
  'Modelado 3D': 'bg-rose-100 text-rose-800',
  'Colaboración': 'bg-teal-100 text-teal-800',
  'Gamificación': 'bg-yellow-100 text-yellow-800',
};

const colorClass = categoryColors[category] || 'bg-gray-100 text-gray-800';
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group block p-5 rounded-xl border border-border bg-white shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all min-h-[120px]"
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <div class="flex items-center gap-3 min-w-0">
      <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
        <span class="text-lg" aria-hidden="true">{icon}</span>
      </div>
      <h3 class="font-bold text-base text-primary group-hover:text-accent transition-colors truncate">
        {name}
      </h3>
    </div>
    {free && (
      <span class="shrink-0 text-xs font-semibold px-2 py-1 rounded-full bg-green-100 text-green-700">
        Gratis
      </span>
    )}
  </div>

  <p class="text-sm text-text-light mb-3 line-clamp-2">{description}</p>

  <div class="flex items-center justify-between">
    <span class:list={['text-xs font-medium px-2.5 py-1 rounded-full', colorClass]}>
      {category}
    </span>
    <svg
      class="w-4 h-4 text-text-light group-hover:text-accent transition-colors"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
    </svg>
  </div>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
