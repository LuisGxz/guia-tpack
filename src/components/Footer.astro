---
const base = import.meta.env.BASE_URL;
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto bg-primary text-white/80">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm">
      <div class="text-center md:text-left">
        <p class="font-semibold text-white" style="font-family: var(--font-heading);">
          Guía Interactiva — Tecnologías Emergentes Educativas
        </p>
        <p class="mt-1">
          Proyecto de tesis de maestría &middot; {currentYear}
        </p>
      </div>
      <nav aria-label="Enlaces del pie de página">
        <a
          href={`${base}referencias/`}
          class="inline-flex items-center gap-1 text-accent-light hover:text-white transition-colors font-medium"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          Ver referencias
        </a>
      </nav>
    </div>
  </div>
</footer>
