---
const base = import.meta.env.BASE_URL;
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto bg-primary text-white/80">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <!-- Institutional Logos -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-8 sm:gap-12 mb-10 pb-8 border-b border-white/15">
      <!-- UE Francisco Huerta Rendón -->
      <div class="flex flex-col items-center text-center">
        <img src={`${base}logo.png`} alt="Logo Unidad Educativa Particular Francisco Huerta Rendón" class="w-20 h-20 rounded-full bg-white p-1 mb-2" />
        <p class="text-white text-xs font-semibold leading-tight max-w-[160px]">
          Unidad Educativa Particular<br />"Francisco Huerta Rendón"
        </p>
      </div>
      <!-- Universidad de Guayaquil -->
      <div class="flex flex-col items-center text-center">
        <img src={`${base}logo-ug.png`} alt="Logo Universidad de Guayaquil" class="w-20 h-20 object-contain bg-white rounded-lg p-1 mb-2" />
        <p class="text-white text-xs font-semibold leading-tight max-w-[160px]">
          Universidad de Guayaquil
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="flex items-center gap-2.5 mb-2">
          <div class="w-9 h-9 rounded-lg bg-white/15 flex items-center justify-center shrink-0">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 19.5C4 18.837 4.263 18.201 4.732 17.732C5.201 17.263 5.837 17 6.5 17H20" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M6.5 2H20V22H6.5C5.837 22 5.201 21.737 4.732 21.268C4.263 20.799 4 20.163 4 19.5V4.5C4 3.837 4.263 3.201 4.732 2.732C5.201 2.263 5.837 2 6.5 2Z" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="10" r="2" fill="#0ea5e9"/>
              <circle cx="16" cy="8" r="1.2" fill="#0ea5e9" opacity="0.7"/>
              <circle cx="10" cy="13.5" r="1" fill="#0ea5e9" opacity="0.5"/>
              <path d="M12 10L16 8" stroke="#0ea5e9" stroke-width="0.8" opacity="0.6"/>
              <path d="M12 10L10 13.5" stroke="#0ea5e9" stroke-width="0.8" opacity="0.6"/>
            </svg>
          </div>
          <p class="font-bold text-white text-lg" style="font-family: var(--font-heading);">
            Tech in Class
          </p>
        </div>
        <p class="text-sm leading-relaxed">
          Guía interactiva para integrar tecnologías emergentes en instituciones educativas.
        </p>
      </div>

      <!-- Technologies -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wide mb-3">Tecnologías</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}inteligencia-artificial/`} class="hover:text-white transition-colors">Inteligencia Artificial</a></li>
          <li><a href={`${base}realidad-virtual/`} class="hover:text-white transition-colors">Realidad Virtual</a></li>
          <li><a href={`${base}realidad-aumentada/`} class="hover:text-white transition-colors">Realidad Aumentada</a></li>
          <li><a href={`${base}simulaciones/`} class="hover:text-white transition-colors">Simulaciones Interactivas</a></li>
        </ul>
      </div>

      <!-- Guide -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wide mb-3">Guía</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}tpack/`} class="hover:text-white transition-colors">Marco TPACK</a></li>
          <li><a href={`${base}plan-implementacion/`} class="hover:text-white transition-colors">Plan de Implementación</a></li>
          <li><a href={`${base}referencias/`} class="hover:text-white transition-colors">Referencias</a></li>
        </ul>
      </div>

      <!-- Project -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wide mb-3">Proyecto</h3>
        <ul class="space-y-2 text-sm">
          <li>Informe de investigación</li>
          <li>Maestría en Educación</li>
          <li>Innovación y Liderazgo Educativo</li>
          <li>Contexto: a nivel mundial</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/15 pt-6 text-sm text-center space-y-1">
      <p>Tech in Class — Tecnologías Emergentes Educativas &middot; Informe de Investigación &middot; {currentYear}</p>
      <p class="text-white/50 text-xs">Mendoza Rodríguez, Y. E. &middot; Soledispa Macías, M. M. &middot; Dir. Ph.D. Figueroa Martínez, E. J.</p>
    </div>
  </div>
</footer>
