---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="text-center mb-12">
  <div class="inline-block mb-4">
    <div class="h-1 w-12 bg-accent rounded-full mx-auto"></div>
  </div>
  <h2 class="text-2xl md:text-3xl font-bold mb-3">{title}</h2>
  {subtitle && (
    <p class="text-text-light text-base md:text-lg max-w-2xl mx-auto">{subtitle}</p>
  )}
</div>
